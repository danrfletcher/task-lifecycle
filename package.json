		"@codemirror/view": "^6.43.15",
		"@types/node": "^20.12.12",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.48.0",
		"@vitest/coverage-v8": "4.1.12",
		"builtin-modules": "^5.0.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.1",
		"eslint-plugin-depend": "1.3.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"happy-dom": "^21.0.4",
		"obsidian": "1.8.7",
		"tslib": "2.4.0",
		"typescript": "^4.9.5",
		"vitest": "4.1.12"
