{
	"name": "task-lifecycle",
	"version": "0.1.0",
	"description": "Status cycle, close stamps and close cascade for Markdown task lines (Obsidian plugin).",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
